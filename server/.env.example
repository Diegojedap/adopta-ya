# Configuración de la API ¡ADOPTA YA!  (copiar a .env y completar en local)
PORT=3000
JWT_SECRET=
CLAVE_ADMIN=
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=adoptaya
# Login con Google (#11): Web client ID de Google Cloud (dato público). Ver docs/05_LOGIN_GOOGLE.md
GOOGLE_CLIENT_ID=
# Opcional: bundle PEM con CAs raíz extra, para redes con inspección TLS corporativa
# (equivale a NODE_EXTRA_CA_CERTS). Si no se indica, se busca certs/windows-ca-bundle.pem.
CA_BUNDLE_PATH=
